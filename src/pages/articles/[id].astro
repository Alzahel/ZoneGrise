---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleMeta, getArticleMeta } from '../../data/articles';
import { withBase } from '../../lib/paths';
import { getResponsiveImage } from '../../lib/responsiveImages';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((article) => articleMeta[article.id]);
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const meta = getArticleMeta(article.id);
const responsiveImage = getResponsiveImage(meta.image);
const { Content, headings } = await render(article);
const sections = headings.filter((heading) => heading.depth === 2);
const rawBody = 'body' in article && typeof article.body === 'string' ? article.body : '';
const wordCount = rawBody.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 220));
const number = String(meta.order).padStart(2, '0');
const viewPath = withBase(`articles/${article.id}`);

const allArticles = (await getCollection('articles'))
  .filter((item) => articleMeta[item.id])
  .sort((a, b) => getArticleMeta(a.id).order - getArticleMeta(b.id).order);
const index = allArticles.findIndex((item) => item.id === article.id);
const previous = index > 0 ? allArticles[index - 1] : undefined;
const next = index < allArticles.length - 1 ? allArticles[index + 1] : undefined;
---

<BaseLayout title={meta.title} description={meta.description} image={meta.image}>
  <article class="article-shell shell">
    <header class="article-header">
      <div class="article-topline">
        <a class="back-link" href={withBase('articles')}>← Tous les articles</a>
        <div class="article-meta-line">
          <span>Essai {number}</span>
          <span>{readingTime} min de lecture</span>
          <span
            class="article-view-count"
            data-article-view-count
            data-view-path={viewPath}
            aria-live="polite"
          >— vues</span>
        </div>
      </div>
      <div class="article-kicker">{meta.tags.join(' · ')}</div>
      <h1>{meta.title}</h1>
      {meta.showDeck !== false && <p class="article-deck">{meta.description}</p>}
      <div class="article-header-rule" aria-hidden="true">
        <span>{number}</span>
      </div>
    </header>

    {meta.image && responsiveImage && (
      <figure class="article-hero-media">
        <picture>
          {responsiveImage.srcset && (
            <source
              type="image/webp"
              srcset={responsiveImage.srcset}
              sizes="(max-width: 820px) calc(100vw - 30px), (min-width: 1091px) 960px, 88vw"
            />
          )}
          <img
            src={responsiveImage.fallback}
            alt={meta.imageAlt ?? ''}
            width="1448"
            height="1086"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </figure>
    )}

    <div class="article-layout">
      {sections.length > 1 && (
        <aside class="article-rail" aria-label="Repères de l’article">
          <div class="article-rail-sticky">
            <p class="rail-label" aria-hidden="true">§</p>
            <ol>
              {sections.map((section, sectionIndex) => (
                <li>
                  <a
                    href={`#${section.slug}`}
                    aria-label={section.text}
                    title={section.text}
                  >
                    <span class="rail-index" aria-hidden="true">{String(sectionIndex + 1).padStart(2, '0')}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </aside>
      )}

      <div class="article-prose">
        <Content />
      </div>
    </div>

    <nav class="article-nav" aria-label="Articles précédent et suivant">
      {previous ? (
        <a href={withBase(`articles/${previous.id}`)}>
          <span>Précédent</span>
          <strong>{getArticleMeta(previous.id).title}</strong>
        </a>
      ) : <span></span>}
      {next ? (
        <a class="next" href={withBase(`articles/${next.id}`)}>
          <span>Suivant</span>
          <strong>{getArticleMeta(next.id).title}</strong>
        </a>
      ) : <span></span>}
    </nav>
  </article>

  <script is:inline>
    (() => {
      const target = document.querySelector('[data-article-view-count]');
      if (!(target instanceof HTMLElement)) return;

      const path = target.dataset.viewPath || window.location.pathname || '/';
      const maxAttempts = 7;
      let attempts = 0;
      let lastCount = null;

      const renderCount = (raw) => {
        const count = String(raw).trim();
        if (!count) return;
        target.textContent = `${count} ${count === '1' ? 'vue' : 'vues'}`;
      };

      const loadCount = async () => {
        attempts += 1;

        try {
          const response = await fetch(
            `https://alzahel.goatcounter.com/counter/${encodeURIComponent(path)}.json?zg=${Date.now()}`,
            { cache: 'no-store' },
          );
          const data = await response.json().catch(() => null);

          if (data?.count !== undefined && data?.count !== null) {
            lastCount = data.count;
          }

          if (response.ok && lastCount !== null) {
            renderCount(lastCount);
            return;
          }
        } catch {
          // Le compteur est un enrichissement : l'article reste lisible si le service est filtré.
        }

        if (attempts < maxAttempts) {
          setTimeout(loadCount, attempts === 1 ? 2500 : 3000);
          return;
        }

        if (lastCount !== null) renderCount(lastCount);
      };

      setTimeout(loadCount, 3000);
    })();
  </script>
</BaseLayout>
