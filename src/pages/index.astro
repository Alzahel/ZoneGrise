---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articleMeta, getArticleMeta } from '../data/articles';
import { withBase } from '../lib/paths';

const articles = (await getCollection('articles'))
  .filter((article) => articleMeta[article.id])
  .sort((a, b) => getArticleMeta(a.id).order - getArticleMeta(b.id).order);

const first = articles[0];
const latest = [...articles].reverse();
---

<BaseLayout>
  <section class="hero shell">
    <p class="eyebrow">IA · création · auteur · légitimité</p>
    <h1>Zone Grise</h1>
    <p class="hero-lede">
      Ni manifeste pro-IA, ni procès à charge. Un endroit pour regarder ce qui change quand les outils deviennent capables de produire avec nous — ou à notre place.
    </p>
    <div class="hero-rule" aria-hidden="true"></div>
  </section>

  {first && (
    <section class="shell section-block">
      <div class="section-heading">
        <p class="eyebrow">Commencer ici</p>
        <p>Le texte qui pose la frontière que Zone Grise veut explorer.</p>
      </div>
      <ArticleCard id={first.id} meta={getArticleMeta(first.id)} featured />
    </section>
  )}

  <section class="shell section-block">
    <div class="section-heading row-heading">
      <div>
        <p class="eyebrow">Derniers essais</p>
        <h2>Deux questions, pas une doctrine.</h2>
      </div>
      <a class="text-link" href={withBase('articles')}>Tous les articles →</a>
    </div>
    <div class="article-grid">
      {latest.map((article) => (
        <ArticleCard id={article.id} meta={getArticleMeta(article.id)} />
      ))}
    </div>
  </section>

  <section class="manifesto-band">
    <div class="shell manifesto-grid">
      <p class="eyebrow">La grille Zone Grise</p>
      <div class="principle">
        <span>01</span>
        <h3>Qu’est-ce que l’outil remplace ?</h3>
        <p>Une tâche, une compétence, un interlocuteur — ou progressivement les décisions qui faisaient le projet.</p>
      </div>
      <div class="principle">
        <span>02</span>
        <h3>Qu’est-ce que l’humain choisit encore ?</h3>
        <p>Le goût se voit autant dans ce qu’on garde que dans ce qu’on refuse de laisser entrer.</p>
      </div>
      <div class="principle">
        <span>03</span>
        <h3>De qui le résultat dépend-il ?</h3>
        <p>La question n’est pas seulement ce que la machine a produit, mais ce qui change quand on change la personne.</p>
      </div>
    </div>
  </section>
</BaseLayout>
