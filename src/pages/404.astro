---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Page introuvable" description="Cette page n’existe pas ou plus sur Zone Grise.">
  <section class="not-found shell">
    <p class="eyebrow">Erreur 404</p>
    <h1>Zone inconnue.</h1>
    <p>Cette page n’existe pas, ou elle a été déplacée. Les zones grises, elles, sont toujours dans les articles.</p>
    <a class="text-link" href={withBase('articles')}>Retour aux articles →</a>
  </section>
</BaseLayout>
