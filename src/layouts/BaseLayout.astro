---
import '../styles/current.css';
import '../styles/editorial.css';
import '../styles/i18n.css';
import { stripBase, withBase } from '../lib/paths';
import type { Locale } from '../data/articles';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale?: Locale;
  alternatePath?: string;
  autoDetectLanguage?: boolean;
}

const {
  title = 'Zone Grise',
  description,
  image = 'images/zone-grise-brand.png',
  locale = 'fr',
  alternatePath,
  autoDetectLanguage = false,
} = Astro.props;

const labels = locale === 'en'
  ? {
      description: 'Essays on AI, creativity, authorship, and the places where simple categories stop working.',
      homeAria: 'Zone Grise — home',
      headerNote: 'Essays on creation in the age of AI',
      navAria: 'Main navigation',
      articles: 'Articles',
      about: 'About',
      themeDark: 'Enable dark mode',
      themeLight: 'Enable light mode',
      night: 'Night',
      day: 'Day',
      toDark: 'Switch to dark mode',
      toLight: 'Switch to light mode',
      languageAria: 'Language',
      footerStatement: 'Looking at what AI changes about creating, without forcing a binary answer.',
    }
  : {
      description: 'Essais sur l’IA, la créativité, l’auteur et les endroits où les catégories simples cessent de fonctionner.',
      homeAria: 'Zone Grise — accueil',
      headerNote: 'Essais sur la création à l’ère de l’IA',
      navAria: 'Navigation principale',
      articles: 'Articles',
      about: 'À propos',
      themeDark: 'Activer le mode sombre',
      themeLight: 'Activer le mode clair',
      night: 'Nuit',
      day: 'Jour',
      toDark: 'Passer au mode sombre',
      toLight: 'Passer au mode clair',
      languageAria: 'Langue',
      footerStatement: 'Regarder ce que l’IA change dans le fait de créer, sans chercher une réponse binaire.',
    };

const resolvedDescription = description ?? labels.description;
const pageTitle = title === 'Zone Grise' ? title : `${title} — Zone Grise`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image), Astro.site);
const currentPath = stripBase(Astro.url.pathname);
const alternateUrl = alternatePath !== undefined
  ? new URL(alternatePath ? withBase(alternatePath) : withBase(), Astro.site)
  : null;
const frUrl = locale === 'fr'
  ? canonical
  : alternateUrl ?? new URL(withBase(), Astro.site);
const enUrl = locale === 'en'
  ? canonical
  : alternateUrl ?? new URL(withBase('en'), Astro.site);

const homeHref = locale === 'en' ? withBase('en') : withBase();
const articlesHref = locale === 'en' ? withBase('en/articles') : withBase('articles');
const aboutHref = locale === 'en' ? withBase('en/about') : withBase('a-propos');
const articlesActive = locale === 'en'
  ? currentPath.startsWith('/en/articles')
  : currentPath.startsWith('/articles');
const aboutActive = locale === 'en'
  ? currentPath === '/en/about'
  : currentPath === '/a-propos';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="theme-color" content="#fbf4e7" />
    <script is:inline>
      (() => {
        const key = 'zone-grise-theme';
        let stored = null;
        try {
          stored = localStorage.getItem(key);
        } catch {}

        const systemDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches ?? false;
        const theme = stored === 'dark' || stored === 'light'
          ? stored
          : systemDark ? 'dark' : 'light';

        document.documentElement.dataset.theme = theme;
        const themeColor = document.querySelector('meta[name="theme-color"]');
        themeColor?.setAttribute('content', theme === 'dark' ? '#171613' : '#fbf4e7');
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon-v5.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Zone Grise" href={withBase('rss.xml')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta property="og:site_name" content="Zone Grise" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'fr_FR'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'fr_FR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage.href} />
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav-shell">
        <a class="wordmark" href={homeHref} aria-label={labels.homeAria}>
          <span class="wordmark-mark" aria-hidden="true"></span>
          <span>Zone Grise</span>
        </a>
        <p class="header-note">{labels.headerNote}</p>
        <nav aria-label={labels.navAria}>
          <a class:list={{ active: articlesActive }} href={articlesHref}>{labels.articles}</a>
          <a class:list={{ active: aboutActive }} href={aboutHref}>{labels.about}</a>
          <span class="language-switch" aria-label={labels.languageAria}>
            <a
              href={frUrl.href}
              aria-current={locale === 'fr' ? 'page' : undefined}
              data-language-choice="fr"
            >FR</a>
            <span aria-hidden="true">/</span>
            <a
              href={enUrl.href}
              aria-current={locale === 'en' ? 'page' : undefined}
              data-language-choice="en"
            >EN</a>
          </span>
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label={labels.themeDark}
            aria-pressed="false"
          >
            <span class="theme-toggle-mark" aria-hidden="true"></span>
            <span class="theme-toggle-label" data-theme-label>{labels.night}</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <p class="footer-label">Zone Grise</p>
          <p class="footer-statement">{labels.footerStatement}</p>
        </div>
        <div class="footer-links">
          <a href={articlesHref}>{labels.articles}</a>
          <a href={aboutHref}>{labels.about}</a>
          <a href={withBase('rss.xml')}>RSS</a>
        </div>
      </div>
    </footer>

    <script
      is:inline
      define:vars={{
        autoDetectLanguage,
        locale,
        englishHomeHref: withBase('en'),
      }}
    >
      (() => {
        const key = 'zone-grise-language';
        const links = document.querySelectorAll('[data-language-choice]');

        links.forEach((link) => {
          link.addEventListener('click', () => {
            const choice = link.getAttribute('data-language-choice');
            if (choice !== 'fr' && choice !== 'en') return;
            try {
              localStorage.setItem(key, choice);
            } catch {}
          });
        });

        if (!autoDetectLanguage || locale !== 'fr') return;

        let stored = null;
        try {
          stored = localStorage.getItem(key);
        } catch {}

        if (stored === 'en') {
          window.location.replace(englishHomeHref);
          return;
        }
        if (stored === 'fr') return;

        const languages = Array.isArray(navigator.languages) && navigator.languages.length
          ? navigator.languages
          : [navigator.language];
        const preferred = languages
          .map((value) => String(value || '').toLowerCase())
          .find((value) => value.startsWith('fr') || value.startsWith('en'));

        if (preferred?.startsWith('en')) {
          try {
            localStorage.setItem(key, 'en');
          } catch {}
          window.location.replace(englishHomeHref);
          return;
        }

        if (preferred?.startsWith('fr')) {
          try {
            localStorage.setItem(key, 'fr');
          } catch {}
        }
      })();
    </script>

    <script
      is:inline
      define:vars={{
        themeDarkLabel: labels.themeDark,
        themeLightLabel: labels.themeLight,
        dayLabel: labels.day,
        nightLabel: labels.night,
        toDarkLabel: labels.toDark,
        toLightLabel: labels.toLight,
      }}
    >
      (() => {
        const root = document.documentElement;
        const button = document.querySelector('[data-theme-toggle]');
        const label = document.querySelector('[data-theme-label]');
        const themeColor = document.querySelector('meta[name="theme-color"]');
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const key = 'zone-grise-theme';

        if (!(button instanceof HTMLButtonElement)) return;

        const syncControl = () => {
          const dark = root.dataset.theme === 'dark';
          button.setAttribute('aria-pressed', String(dark));
          button.setAttribute('aria-label', dark ? themeLightLabel : themeDarkLabel);
          button.title = dark ? toLightLabel : toDarkLabel;
          if (label) label.textContent = dark ? dayLabel : nightLabel;
          themeColor?.setAttribute('content', dark ? '#171613' : '#fbf4e7');
        };

        button.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem(key, next);
          } catch {}
          syncControl();
        });

        media.addEventListener?.('change', (event) => {
          let stored = null;
          try {
            stored = localStorage.getItem(key);
          } catch {}
          if (stored === 'light' || stored === 'dark') return;
          root.dataset.theme = event.matches ? 'dark' : 'light';
          syncControl();
        });

        syncControl();
      })();
    </script>

    <script is:inline>
      (() => {
        const endpoint = 'https://alzahel.goatcounter.com/count';

        try {
          if (localStorage.getItem('skipgc') === 't') return;
        } catch {}

        const send = () => {
          const params = new URLSearchParams();
          params.set('p', window.location.pathname || '/');
          params.set('t', document.title);
          if (document.referrer) params.set('r', document.referrer);
          if (window.screen?.width) params.set('s', String(window.screen.width));
          if (window.location.search) params.set('q', window.location.search);
          if (navigator.webdriver) params.set('b', '153');
          params.set('rnd', Math.random().toString(36).slice(2, 8));

          const url = `${endpoint}?${params.toString()}`;

          if (navigator.sendBeacon?.(url)) return;

          const image = new Image(1, 1);
          image.alt = '';
          image.setAttribute('aria-hidden', 'true');
          image.src = url;
        };

        if (!('visibilityState' in document) || document.visibilityState === 'visible') {
          send();
          return;
        }

        const onVisible = () => {
          if (document.visibilityState !== 'visible') return;
          document.removeEventListener('visibilitychange', onVisible);
          send();
        };
        document.addEventListener('visibilitychange', onVisible);
      })();
    </script>
  </body>
</html>
