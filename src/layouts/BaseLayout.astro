---
import '../styles/current.css';
import { stripBase, withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Zone Grise',
  description = 'Essais sur l’IA, la créativité, l’auteur et les endroits où les catégories simples cessent de fonctionner.',
  image = 'images/zone-grise-brand.png',
} = Astro.props;

const pageTitle = title === 'Zone Grise' ? title : `${title} — Zone Grise`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image), Astro.site);
const currentPath = stripBase(Astro.url.pathname);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf4e7" />
    <script is:inline>
      (() => {
        const key = 'zone-grise-theme';
        let stored = null;
        try {
          stored = localStorage.getItem(key);
        } catch {}

        const systemDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches ?? false;
        const theme = stored === 'dark' || stored === 'light'
          ? stored
          : systemDark ? 'dark' : 'light';

        document.documentElement.dataset.theme = theme;
        const themeColor = document.querySelector('meta[name="theme-color"]');
        themeColor?.setAttribute('content', theme === 'dark' ? '#171613' : '#fbf4e7');
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon-v5.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Zone Grise" href={withBase('rss.xml')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta property="og:site_name" content="Zone Grise" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage.href} />
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav-shell">
        <a class="wordmark" href={withBase()} aria-label="Zone Grise — accueil">
          <span class="wordmark-mark" aria-hidden="true"></span>
          <span>Zone Grise</span>
        </a>
        <p class="header-note">Essais sur la création à l’ère de l’IA</p>
        <nav aria-label="Navigation principale">
          <a class:list={{ active: currentPath.startsWith('/articles') }} href={withBase('articles')}>Articles</a>
          <a class:list={{ active: currentPath === '/a-propos' }} href={withBase('a-propos')}>À propos</a>
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label="Activer le mode sombre"
            aria-pressed="false"
          >
            <span class="theme-toggle-mark" aria-hidden="true"></span>
            <span class="theme-toggle-label" data-theme-label>Nuit</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <p class="footer-label">Zone Grise</p>
          <p class="footer-statement">Regarder ce que l’IA change dans le fait de créer, sans chercher une réponse binaire.</p>
        </div>
        <div class="footer-links">
          <a href={withBase('articles')}>Articles</a>
          <a href={withBase('a-propos')}>À propos</a>
          <a href={withBase('rss.xml')}>RSS</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.querySelector('[data-theme-toggle]');
        const label = document.querySelector('[data-theme-label]');
        const themeColor = document.querySelector('meta[name="theme-color"]');
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const key = 'zone-grise-theme';

        if (!(button instanceof HTMLButtonElement)) return;

        const syncControl = () => {
          const dark = root.dataset.theme === 'dark';
          button.setAttribute('aria-pressed', String(dark));
          button.setAttribute('aria-label', dark ? 'Activer le mode clair' : 'Activer le mode sombre');
          button.title = dark ? 'Passer au mode clair' : 'Passer au mode sombre';
          if (label) label.textContent = dark ? 'Jour' : 'Nuit';
          themeColor?.setAttribute('content', dark ? '#171613' : '#fbf4e7');
        };

        button.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem(key, next);
          } catch {}
          syncControl();
        });

        media.addEventListener?.('change', (event) => {
          let stored = null;
          try {
            stored = localStorage.getItem(key);
          } catch {}
          if (stored === 'light' || stored === 'dark') return;
          root.dataset.theme = event.matches ? 'dark' : 'light';
          syncControl();
        });

        syncControl();
      })();
    </script>

    <script
      data-goatcounter="https://alzahel.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
    ></script>
  </body>
</html>
