---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Zone Grise',
  description = 'Essais sur l’IA, la créativité, l’auteur et les endroits où les catégories simples cessent de fonctionner.',
} = Astro.props;

const pageTitle = title === 'Zone Grise' ? title : `${title} — Zone Grise`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe7" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Zone Grise" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content="Zone Grise" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav-shell">
        <a class="wordmark" href="/" aria-label="Zone Grise — accueil">
          <span class="wordmark-mark" aria-hidden="true"></span>
          <span>Zone Grise</span>
        </a>
        <nav aria-label="Navigation principale">
          <a class:list={{ active: Astro.url.pathname.startsWith('/articles') }} href="/articles">Articles</a>
          <a class:list={{ active: Astro.url.pathname === '/a-propos' }} href="/a-propos">À propos</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <div class="footer-name">Zone Grise</div>
          <p>Regarder ce que l’IA change dans le fait de créer, sans chercher une réponse binaire.</p>
        </div>
        <div class="footer-links">
          <a href="/articles">Articles</a>
          <a href="/a-propos">À propos</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>
